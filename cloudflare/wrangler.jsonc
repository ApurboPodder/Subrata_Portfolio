{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subrata-portfolio-api",
  "main": "worker.js",
  "compatibility_date": "2025-03-01",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "subrata-portfolio-auth",
    "ALLOWED_ORIGINS": "https://subratakumer.vercel.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subrata-portfolio",
      "database_id": "100d97be-c653-4d2e-99ee-7e6daffac7d1",
      "migrations_dir": "migrations"
    }
  ]
}
